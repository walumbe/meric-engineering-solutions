# Copy to .env.local for local work. On Vercel set these under Project > Settings > Environment Variables.

# Public (safe in the browser)
VITE_SITE_URL=                    # e.g. https://www.yourdomain.co.ke  (canonical URLs + sitemap)
VITE_SELF_HOSTED_IMAGES=false     # set to true after running `npm run images:download` and committing public/images

# Private (server only, used by api/enquiry.ts)
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=                 # the inbox that should receive enquiries (supplied by the company)
ENQUIRY_FROM_EMAIL=               # e.g. "Meric Website <enquiries@yourdomain.co.ke>" on a domain verified in Resend
ALLOWED_ORIGIN=                   # optional, e.g. https://www.yourdomain.co.ke
